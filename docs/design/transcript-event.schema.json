{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "swarmai/transcript-event",
  "title": "Session subscription envelope (GET /api/chat/events)",
  "description": "The contract between the backend that publishes (core/session_events, core/transcript_feed, core/session_state, a turn's events through SessionRouter._published_turn) and the desktop that renders (services/sessionEvents, hooks/sessionTurnRouter, hooks/transcriptFeed, hooks/useChatStreamingLifecycle). Every published envelope carries the base fields; the types listed under $defs carry the fields the desktop depends on. Other turn event types (warnings, progress, notices) carry the base fields only. Checked by backend/tests/test_transcript_event_schema.py against every envelope the real backend produced in the liveReload fixture, and against the desktop and backend sources (each type named here is produced and consumed). Design: docs/design/chat-transcript-single-source.md 3.2.",
  "type": "object",
  "required": ["type", "sessionId", "eventSeq"],
  "properties": {
    "type": {"type": "string"},
    "sessionId": {"type": "string", "minLength": 1},
    "eventSeq": {"type": "integer", "minimum": 0},
    "turnId": {"type": ["string", "null"], "description": "the turn this event belongs to; empty for events outside any turn"},
    "turnClientId": {"type": "string", "description": "the persisted assistant row's client_id"}
  },
  "allOf": [
    {"if": {"properties": {"type": {"const": "turn_start"}}}, "then": {"$ref": "#/$defs/turn_start"}},
    {"if": {"properties": {"type": {"const": "turn_end"}}}, "then": {"$ref": "#/$defs/turn_end"}},
    {"if": {"properties": {"type": {"const": "assistant"}}}, "then": {"$ref": "#/$defs/assistant"}},
    {"if": {"properties": {"type": {"const": "text_delta"}}}, "then": {"$ref": "#/$defs/text_delta"}},
    {"if": {"properties": {"type": {"const": "thinking_delta"}}}, "then": {"$ref": "#/$defs/thinking_delta"}},
    {"if": {"properties": {"type": {"const": "tool_result"}}}, "then": {"$ref": "#/$defs/tool_result"}},
    {"if": {"properties": {"type": {"const": "ask_user_question"}}}, "then": {"$ref": "#/$defs/ask_user_question"}},
    {"if": {"properties": {"type": {"const": "cmd_permission_request"}}}, "then": {"$ref": "#/$defs/cmd_permission_request"}},
    {"if": {"properties": {"type": {"const": "result"}}}, "then": {"$ref": "#/$defs/result"}},
    {"if": {"properties": {"type": {"const": "resync"}}}, "then": {"$ref": "#/$defs/resync"}},
    {"if": {"properties": {"type": {"const": "transcript_row"}}}, "then": {"$ref": "#/$defs/transcript_row"}},
    {"if": {"properties": {"type": {"const": "transcript_delete"}}}, "then": {"$ref": "#/$defs/transcript_delete"}},
    {"if": {"properties": {"type": {"const": "session_state"}}}, "then": {"$ref": "#/$defs/session_state"}},
    {"if": {"properties": {"type": {"const": "background_agents"}}}, "then": {"$ref": "#/$defs/background_agents"}}
  ],
  "$defs": {
    "inTurn": {"required": ["turnId"], "properties": {"turnId": {"type": "string", "minLength": 1}}},
    "outsideTurn": {"required": ["turnId"], "properties": {"turnId": {"const": ""}}},
    "turn_start": {"allOf": [{"$ref": "#/$defs/inTurn"}], "required": ["source"],
      "properties": {"source": {"enum": ["chat", "drain", "channel", "injected", "answer", "permission"]}}},
    "turn_end": {"allOf": [{"$ref": "#/$defs/inTurn"}]},
    "assistant": {"allOf": [{"$ref": "#/$defs/inTurn"}], "required": ["content"],
      "properties": {"content": {"type": "array", "items": {"type": "object", "required": ["type"]}}}},
    "text_delta": {"allOf": [{"$ref": "#/$defs/inTurn"}], "required": ["text", "index"],
      "properties": {"text": {"type": "string"}, "index": {"type": "integer"}}},
    "thinking_delta": {"allOf": [{"$ref": "#/$defs/inTurn"}], "required": ["thinking", "index"],
      "properties": {"thinking": {"type": "string"}, "index": {"type": "integer"}}},
    "tool_result": {"allOf": [{"$ref": "#/$defs/inTurn"}], "required": ["content"],
      "properties": {"content": {"type": "array"}}},
    "ask_user_question": {"allOf": [{"$ref": "#/$defs/inTurn"}], "required": ["toolUseId", "questions"],
      "properties": {"toolUseId": {"type": "string", "minLength": 1}, "questions": {"type": "array"}}},
    "cmd_permission_request": {"allOf": [{"$ref": "#/$defs/inTurn"}], "required": ["requestId", "toolName", "reason"],
      "properties": {"requestId": {"type": "string", "minLength": 1}, "toolName": {"type": "string"}, "reason": {"type": "string"}}},
    "result": {"allOf": [{"$ref": "#/$defs/inTurn"}]},
    "resync": {"required": ["activeTurnId"], "properties": {"activeTurnId": {"type": ["string", "null"]}}},
    "transcript_row": {"allOf": [{"$ref": "#/$defs/outsideTurn"}], "required": ["row", "rev", "op"],
      "properties": {
        "row": {"type": "object", "required": ["id", "role", "content"],
          "properties": {"id": {"type": "string", "minLength": 1}, "role": {"enum": ["user", "assistant", "system"]}, "content": {"type": "array"}}},
        "rev": {"type": "integer", "minimum": 1},
        "op": {"enum": ["insert", "update", "upsert"]},
        "pending": {"type": "boolean"}}},
    "transcript_delete": {"allOf": [{"$ref": "#/$defs/outsideTurn"}], "required": ["rowId", "rev"],
      "properties": {"rowId": {"type": "string", "minLength": 1}, "rev": {"type": "integer", "minimum": 1}}},
    "session_state": {"allOf": [{"$ref": "#/$defs/outsideTurn"}], "required": ["state"],
      "properties": {"snapshot": {"type": "boolean"},
        "state": {"type": "object", "required": ["streaming", "state", "waiting_input", "pending_count"],
          "properties": {"streaming": {"type": "boolean"}, "state": {"type": "string"}, "waiting_input": {"type": "boolean"}, "pending_count": {"type": "integer"}}}}},
    "background_agents": {"required": ["agents"], "properties": {"agents": {"type": "array"}}}
  }
}
