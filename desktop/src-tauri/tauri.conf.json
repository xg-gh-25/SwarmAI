{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SwarmAI",
  "version": "2.4.3",
  "identifier": "com.swarmai.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:full",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bash scripts/pre-build.sh",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "img-src 'self' http://localhost:* http://127.0.0.1:* http://tauri.localhost http://asset.localhost asset: data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": {
      "../resources/daemon/com.swarmai.backend.plist.template": "daemon/com.swarmai.backend.plist.template",
      "../resources/daemon/com.swarmai.guardian.plist.template": "daemon/com.swarmai.guardian.plist.template",
      "../resources/daemon/daemon_guard.py": "daemon/daemon_guard.py",
      "../resources/daemon/swarmai_backend.sh": "daemon/swarmai_backend.sh",
      "../resources/daemon/swarmai_guardian.sh": "daemon/swarmai_guardian.sh",
      "../resources/default-agent.json": "default-agent.json",
      "../resources/default-mcp-servers.json": "default-mcp-servers.json",
      "../resources/mcp-catalog.json": "mcp-catalog.json",
      "../resources/required-cli-tools.json": "required-cli-tools.json"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "externalBin": []
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdCOUNFREI1RDNDNThBNEQKUldSTmlzWFR0ZTJjZS8ydVk0Y3UvUlFaRG83QlBUMU44NE45OGs5YWNJY09DZU9tTi9ocUdtbGYK",
      "endpoints": [
        "https://github.com/xg-gh-25/SwarmAI/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
