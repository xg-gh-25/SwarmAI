# Python
__pycache__/
*.py[cod]

# Projects — only SwarmAI is public (ships as the sample DDD); all others private.
Projects/*
!Projects/SwarmAI/
# SwarmAI ships as the reference six-section DDD, but its RUNTIME artifacts never
# leave the laptop — only the structure + authored content is the sample.
# NOTE: gitignore has NO inline comments — patterns must stand alone on their line.
# pipeline run records (per-run working memory)
Projects/SwarmAI/.artifacts/
# SQLite code-intel graph + WAL sidecars (binary runtime)
Projects/*/code_intel.db
Projects/*/code_intel.db-shm
Projects/*/code_intel.db-wal
# advisory doc-write locks (runtime)
Projects/SwarmAI/.*.md.lock
# runtime usage counters (drift, not sample content)
Projects/SwarmAI/.ddd-usage.json
Projects/SwarmAI/.ddd-usage.json.lock
# Eval private golden set — instance-specific cases (ref local MEMORY/STEERING).
# Public golden_set.yaml ships; this gitignored sibling never leaves the laptop.
# Eval/ is a top-level system subsystem (sibling of Projects/), decoupled from DDD.
Eval/golden_set.private.yaml
Eval/golden_set.private.yaml.lock
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
/workspace/
# Virtual environments
.venv/
venv/
ENV/
env/
progress.md
task_plan.md
findings.md
# .claude/ — project settings and hooks are committed (per Claude Code convention)
# Only ignore local overrides
.claude/settings.local.json
.specify/
# Environment variables
.env
.env.local
.env.bak
# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# TypeScript
*.tsbuildinfo

# Build outputs
frontend/dist/
frontend/build/

# Logs
logs/
*.log

# Process IDs
.pids/
*.pid

# OS
.DS_Store
Thumbs.db

# Test coverage
.coverage
htmlcov/
.pytest_cache/
coverage/
.hypothesis/

# Temp test databases
swarmai_test_*.db

# Stray SQLite databases — no *.db is ever committed (0 tracked); DBs are runtime
# or build artifacts. This catch-all stops a mis-isolated test from leaving a
# database in the worktree, and covers WAL/SHM sidecars. Committed DBs (none today)
# would need `git add -f`. Specific entries above/below are kept for documentation.
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Seed database (build artifact, regenerated by generate_seed_db.py)
desktop/resources/seed.db
# SQLite migration mutex files (fcntl.flock advisory locks, created at DB init)
*.migration-lock

# Temporary files
*.tmp
*.bak
*.swp

# Git worktrees
.worktrees/

# User-local MCP config (machine-specific, contains absolute paths)
desktop/resources/user-mcp-servers.json
backend/pytest-of-gawan/
pytest-of-gawan/
*.lock

# CMHK internal skills — AWS sensitive data, local only
backend/skills/s_cmhk-*/
backend/skills/_shared/
Services/cmhk-quick-mcp/

# Internal-only skills — Amazon-internal tooling (CRUX / Brazil / builder-mcp /
# CriticService). Must NEVER ship to the public GitHub repo. Local-only, like the
# CMHK skills above. ONE glob by naming convention (s_internal-*) so this can't
# drift the way per-skill lines did — every Amazon-internal skill is named
# s_internal-* and is caught here automatically (leak-fix root cause, 2026-07-12).
backend/skills/s_internal-*/

# Internal-only DDD gates — the ③ gate templates copied into an INTERNAL DDD at
# provision (currently no_git_push: Amazon CRUX "git push forbidden, auto-merge owns
# the remote"). Amazon-internal workflow — must NEVER ship to the public repo. Kept
# on disk (provisioning reads templates/ddd-gates/), tracked nowhere. External DDDs
# get no gate from here. (leak-fix: these 2 files were git-tracked, run_d0216c92.)
backend/templates/ddd-gates/

# Test-leak guard: a mock whose .db_path/.path attr auto-vivifies to a MagicMock
# gets its repr written as a filename when passed to open()/Path. 0-byte junk.
*MagicMock name=*

# Agent review artifacts: the semantic_reviewer subagent writes its report here.
# "Untracked but present" is not a safe resting state in this repo — auto-commit
# runs `git add -A` roughly every minute, so anything left on disk eventually
# lands in a commit whether it belongs there or not. Ignore rather than remember.
semantic-review/
