# Python
__pycache__/
*.py[cod]

# Projects — only SwarmAI is public; all others are private/internal
Projects/*
!Projects/SwarmAI/
Projects/*/code_intel.db
# Eval private golden set — instance-specific cases (ref local MEMORY/STEERING).
# Public golden_set.yaml ships; this gitignored sibling never leaves the laptop.
# Eval/ is a top-level system subsystem (sibling of Projects/), decoupled from DDD.
Eval/golden_set.private.yaml
Eval/golden_set.private.yaml.lock
*$py.class
*.so
