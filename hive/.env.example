# SwarmAI Hive — Environment Configuration
#
# Copy to .env and customize before running setup.sh
# Most values have sensible defaults for EC2 deployment.

# ---------------------------------------------------------------------------
# Auth (reference only — provisioner handles this automatically)
# ---------------------------------------------------------------------------
# NOTE: Domain is NOT configured here. CloudFront terminates TLS.
# Caddy listens on :80 only (HTTP). Do NOT add a domain name to the
# Caddyfile — it enables auto-HTTPS and causes redirect loops.
#
# Auth credentials are generated by the provisioner and baked into
# /etc/caddy/Caddyfile. These env vars are for manual setups only.
HIVE_USER=admin
HIVE_PASS_HASH=CHANGE_ME_RUN_caddy_hash_password

# ---------------------------------------------------------------------------
# AWS Configuration
# ---------------------------------------------------------------------------

# AWS region for Bedrock Claude API
# Use IAM instance role for credentials — no access keys needed
AWS_DEFAULT_REGION=us-east-1

# ---------------------------------------------------------------------------
# SwarmAI Configuration
# ---------------------------------------------------------------------------

# Deployment mode (set automatically by swarmai-hive.sh)
SWARMAI_MODE=hive

# Backend port (default: 18321, same as daemon mode)
# NOTE: Also hardcoded in Caddyfile, user_data.py template, and swarmai-hive.service.
# Changing here alone is NOT sufficient — update all 4 locations.
SWARMAI_PORT=18321

# Claude SDK configuration
CLAUDE_CODE_USE_BEDROCK=1
CLAUDE_CODE_DISABLE_AUTO_MEMORY=1

# ---------------------------------------------------------------------------
# Slack Bot (optional)
# ---------------------------------------------------------------------------
# Slack tokens are stored in the database, not env vars.
# Configure via /api/channels endpoint after first startup.
# Slack Socket Mode is outbound — no inbound port needed.

# ---------------------------------------------------------------------------
# Repository (for setup.sh)
# ---------------------------------------------------------------------------

# Override if using a fork or private repo
# SWARMAI_REPO_URL=https://github.com/xg-gh-25/SwarmAI.git
# SWARMAI_REPO_BRANCH=main
