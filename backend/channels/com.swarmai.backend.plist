<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.swarmai.backend</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__WRAPPER_PATH__</string>
    </array>

    <!-- WorkingDirectory set by wrapper script (cd $BACKEND_DIR) -->

    <!-- Start on login and restart on crash -->
    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <!-- Standard priority. NOT Background: Background puts the daemon and every
         child (claude CLI, pipeline tests) at Darwin priority 4 on efficiency
         cores with throttled I/O, so under foreground load the asyncio loop AND
         the heartbeat thread starve for 20s+ and the app shows a false
         "Backend offline". The guardian stays Background (it is a 30s poller). -->
    <key>ProcessType</key>
    <string>Standard</string>

    <!-- Graceful shutdown timeout: SIGKILL after 15s if process ignores SIGTERM -->
    <key>ExitTimeOut</key>
    <integer>15</integer>

    <!-- Throttle restarts: wait 10s between launches -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>__LOG_DIR__/backend-stdout.log</string>

    <key>StandardErrorPath</key>
    <string>__LOG_DIR__/backend-stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>__HOME__</string>
        <key>PATH</key>
        <string>__HOME__/.toolbox/bin:__HOME__/.local/bin:__HOME__/.local/share/mise/shims:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>SWARMAI_MODE</key>
        <string>daemon</string>
        <!-- Self-heal: 0=off | 1=all sessions | canary=first non-channel session -->
        <key>SWARMAI_SELF_HEAL</key>
        <string>1</string>
    </dict>
</dict>
</plist>
