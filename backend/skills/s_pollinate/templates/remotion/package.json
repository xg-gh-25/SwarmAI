{
  "name": "pollinate-remotion",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion video templates for Pollinate content production",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render Root.tsx MainVideo --output out/video.mp4",
    "render-short": "remotion render Root.tsx ShortVideo --output out/short.mp4",
    "render-thumb": "remotion still Root.tsx Thumbnail16x9 --output out/thumb-16x9.png"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/lottie": "^4.0.456",
    "@remotion/media-utils": "^4.0.456",
    "@remotion/paths": "^4.0.456",
    "@remotion/transitions": "^4.0.0",
    "lucide-react": "^1.14.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "remotion": "^4.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "typescript": "^5.5.0"
  }
}
