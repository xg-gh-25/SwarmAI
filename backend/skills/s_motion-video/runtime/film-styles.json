{
  "_about": "How the film layer (runtime/film-layer.js) takes its look from each ported style. scripts/film.py copies the entry of the storyboard's style into scenes/film-data.js; film.json 'classes' and 'tokens' override it per project. tokens: CSS variables of the style that the layer's neutral parts read (accent, ink, muted, rule, font); a token the style lacks falls back to the text colour and the inherited font. classes: the style's own class for a part, added next to the layer's neutral class, so the style's rules win; '{mask}' is replaced by the mask side. A style made with references/stylegen.md gets an entry here when it is ported (or a 'tokens' block in the project's film.json). tests/test_film_layer.py checks that every name here exists in the style's .css.",
  "styles": {
    "exec-brief": {
      "tokens": {"accent": "--eb-accent", "ink": "--eb-ink", "muted": "--eb-mute", "rule": "--eb-rule", "font": "--eb-sans"},
      "classes": {"kicker": "eb-kicker"}
    },
    "exec-dark": {
      "tokens": {"accent": "--ed-accent", "ink": "--ed-text", "muted": "--ed-mute", "rule": "--ed-rule2", "font": "--ed-sans"},
      "classes": {"plate": "ed-plate", "mask": "ed-shade-{mask}", "vignette": "ed-vignette", "kicker": "ed-kicker",
                  "progress": "ed-progress", "progress_fill": "ed-progress-fill", "progress_mark": "ed-progress-mark"}
    },
    "dark-keynote": {
      "tokens": {"accent": "--dk-accent", "ink": "--dk-text", "muted": "--dk-mute", "rule": "--dk-line", "font": "--dk-sans"},
      "classes": {"vignette": "dk-vignette"}
    },
    "dataviz": {
      "tokens": {"accent": "--dv-accent", "ink": "--dv-ink", "muted": "--dv-ink-soft", "rule": "--dv-rule", "font": "--dv-mono"},
      "classes": {}
    },
    "iso-infographic": {
